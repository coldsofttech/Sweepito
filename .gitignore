# Language-specific rules live next to the code:
#   python/.gitignore
#   extensions/vscode/.gitignore

# Local environment files
.env
.envrc

# Logs and temporary files
*.log
.temp/

# Documentation build output (mkdocs/Zensical)
docs/_build/
/site

# OS files
.DS_Store
Thumbs.db

# Editors (shared workspace settings under .vscode/ are not ignored)
.idea/
*.swp

# Local tooling
CLAUDE.md
sweepito.toml
