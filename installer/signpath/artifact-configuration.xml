<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the Windows setup. Paste it into the project in SignPath
     with the slug "windows-setup" (see docs/packaging.md). release.yml uploads the unsigned
     setup.exe as a GitHub artifact, which SignPath receives as a zip with the file at its root. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="sweepito-*.setup.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
